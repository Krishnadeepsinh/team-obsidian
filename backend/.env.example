# TEAM OBSIDIAN - Backend Environment Template
# Copy to .env and replace placeholder values with real credentials. Never commit .env!

APP_ENV=development
DEBUG=false

# Database: PostgreSQL (Supabase Session Pooler recommended for IPv4) or local SQLite fallback
# SQLite local fallback: sqlite:///./obsidian.db
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth & Storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# AI Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
PRIMARY_LLM=gemini-3.5-flash
SECONDARY_LLM=gemini-3.5-flash-lite
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Security (Generate strong random values for production)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex-secret
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-base64-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & URLs (Comma-separated origins; never use * with credentials in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Source Integrations (OAuth Apps & Optional Dev Tokens)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_API_KEY=

# Email Delivery (Password Reset & Invitations)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@teamobsidian.local

